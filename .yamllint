extends: default
ignore: |
  .terraform/
rules:
  line-length:
    max: 200
    level: warning
  document-start: disable
  indentation:
    spaces: consistent
    indent-sequences: whatever
  truthy:
    allowed-values: ["true", "false", "on"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
