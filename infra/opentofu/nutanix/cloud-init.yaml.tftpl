#cloud-config
hostname: ${hostname}
# Break-glass model (owner ruling 2026-11-21, issue #43): "NOPASSWD + key + alert". Passwordless sudo for this
# account only, its key accepted only from the jump host, and every sudo use written to a log the audit pipeline
# ships and alerts on. The password stays locked; no other path to root exists.
users:
  - name: breakglass
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${jsonencode("from=\"${join(",", jump_host_cidrs)}\" ${ssh_authorized_key}")}
ssh_pwauth: false
disable_root: true
write_files:
  - path: /etc/sudoers.d/90-breakglass-log
    permissions: "0440"
    content: |
      Defaults:breakglass logfile=/var/log/breakglass-sudo.log, log_year, log_host
  - path: /etc/innovox/node.env
    permissions: "0644"
    content: |
      NODE_POOL=${pool}
      RKE2_ROLE=${role}
      RKE2_FIRST_SERVER=${first_server}
%{ if !first_server ~}
      RKE2_SERVER_URL=https://${control_plane_address}:9345
%{ endif ~}
%{ if role == "server" ~}
      RKE2_TLS_SAN=${control_plane_address}
%{ endif ~}
runcmd:
  - [sh, -c, "echo 'node prepared for RKE2 ${role} (${pool})' > /etc/motd"]
